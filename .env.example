# appv24 local environment template.
# Copy to .env and fill only the providers/connectors you intend to test.
# Do not commit real secrets.

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------

# Primary provider used by OpenRouter-backed model tests.
OPENROUTER_API_KEY=

# Optional direct provider keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
STEPFUN_API_KEY=

# Optional worker/provider override used by appv24 worker LLM registration.
APPV24_WORKER_LLM_PROVIDER=
APPV24_WORKER_LLM_MODEL=
APPV24_WORKER_LLM_API_KEY=

# ---------------------------------------------------------------------------
# Workflow live-mode gates
# ---------------------------------------------------------------------------

# Keep these false/empty until you intentionally run a live workflow mode.
APPV24_WORKFLOW_LIVE_READ_ENABLED=false
APPV24_WORKFLOW_LIVE_DRAFT_ENABLED=false
APPV24_WORKFLOW_LIVE_PRODUCTION_ENABLED=false

# Optional: alternate env file used by generated workflow service scripts.
APPV24_WORKFLOW_ENV_FILE=.env

# Required only for local webhook service/ingress tests.
APPV24_WORKFLOW_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Generic HTTP read connector: http.fetch
# ---------------------------------------------------------------------------

# Required permission preflight for workflow packages using connector: http.
APPV24_HTTP_CREDENTIAL_REF=
APPV24_HTTP_SCOPES=http:read

# Required transport allowlist for live-read http.fetch.
# Example: 127.0.0.1,api.example.com,news.example.com
APPV24_HTTP_FETCH_ALLOWED_HOSTS=
APPV24_HTTP_FETCH_TIMEOUT_SECONDS=15
APPV24_HTTP_FETCH_MAX_RESPONSE_BYTES=65536
APPV24_HTTP_FETCH_FOLLOW_REDIRECTS=false

# ---------------------------------------------------------------------------
# Generic source read connectors: source.fetch_items/source.fetch_document
# ---------------------------------------------------------------------------

APPV24_SOURCE_CREDENTIAL_REF=
APPV24_SOURCE_SCOPES=source:read
APPV24_SOURCE_BASE_URL=

# ---------------------------------------------------------------------------
# GitHub read connector: github.list_dependabot_alerts
# ---------------------------------------------------------------------------

APPV24_GITHUB_CREDENTIAL_REF=
APPV24_GITHUB_SCOPES=dependabot:read
APPV24_GITHUB_TOKEN=
APPV24_GITHUB_API_BASE_URL=https://api.github.com

# ---------------------------------------------------------------------------
# Brave Search read connector: brave.search
# ---------------------------------------------------------------------------

APPV24_BRAVE_CREDENTIAL_REF=
APPV24_BRAVE_SCOPES=brave:search
APPV24_BRAVE_SEARCH_API_KEY=
APPV24_BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search

# ---------------------------------------------------------------------------
# Gmail draft connector: gmail.create_draft
# ---------------------------------------------------------------------------

APPV24_GMAIL_CREDENTIAL_REF=
APPV24_GMAIL_SCOPES=gmail.compose

# Use either an access token or the refresh-token flow below.
APPV24_GMAIL_ACCESS_TOKEN=
APPV24_GMAIL_REFRESH_TOKEN=
APPV24_GMAIL_CLIENT_ID=
APPV24_GMAIL_CLIENT_SECRET=
APPV24_GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1
APPV24_GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token

# ---------------------------------------------------------------------------
# Telegram approved-target connector: telegram.send_message
# ---------------------------------------------------------------------------

APPV24_TELEGRAM_CREDENTIAL_REF=
APPV24_TELEGRAM_SCOPES=telegram:send
APPV24_TELEGRAM_BOT_TOKEN=

# Comma-separated allowlist. The connector must refuse chats outside this set.
APPV24_TELEGRAM_ALLOWED_CHAT_IDS=
APPV24_TELEGRAM_API_BASE_URL=https://api.telegram.org

# ---------------------------------------------------------------------------
# Optional local app/runtime controls
# ---------------------------------------------------------------------------

APPV24_HOME=
APPV24_EXPERIMENTAL=0
APPV24_TUI_MOUSE=
APPV24_HARDWARE_CURSOR=
APPV24_CLEAR_ON_SHRINK=
